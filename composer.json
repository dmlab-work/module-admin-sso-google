{
    "name": "dmlab/module-admin-sso-google",
    "description": "Google Workspace provider plugin for Magento 2 admin SSO — supplies the Google OIDC preset (fixed discovery URL, scopes, hosted-domain restriction, branding) for the provider-agnostic admin-sso capability. Installs admin-sso (and sso-core) automatically.",
    "type": "magento2-module",
    "license": "OSL-3.0",
    "version": "0.2.1",
    "keywords": [
        "magento2",
        "magento2-module",
        "magento 2",
        "sso",
        "single sign-on",
        "oidc",
        "openid connect",
        "admin login",
        "google workspace",
        "google login",
        "google sso"
    ],
    "homepage": "https://github.com/dmlab-work/module-admin-sso-google",
    "support": {
        "issues": "https://github.com/dmlab-work/module-admin-sso-google/issues",
        "source": "https://github.com/dmlab-work/module-admin-sso-google"
    },
    "require": {
        "php": "~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "^103.0.7",
        "magento/module-config": "^101.2.7",
        "dmlab/module-sso-core": "^0.2.0",
        "dmlab/module-admin-sso": "^0.2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5||^12.5"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "DmLab\\AdminSsoGoogle\\": ""
        }
    }
}
